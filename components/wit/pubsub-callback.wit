/// Inbound pub/sub — the application side of Dapr publish & subscribe.
/// `list-topic-subscriptions` declares what the app subscribes to (the
/// provider renders it to `GET /dapr/subscribe` or `ListTopicSubscriptions`),
/// and `on-topic-event` receives each delivered CloudEvent. Mirrors
/// `AppCallback.ListTopicSubscriptions` / `OnTopicEvent`.
/// https://docs.dapr.io/reference/api/pubsub_api/
interface pubsub-callback {
  use types.{metadata};

  /// One routing rule: when the CEL expression `match` evaluates to true for
  /// an event, the sidecar delivers it to `path`. Rules are evaluated in
  /// order; the first match wins. Mirrors `TopicRule` / the HTTP API's
  /// `routes.rules[]` entry `{match, path}`.
  /// https://docs.dapr.io/developing-applications/building-blocks/pubsub/howto-route-messages/
  record topic-rule {
    /// CEL expression over the CloudEvent, e.g. `event.type == "widget"`.
    match: string,
    /// The route this rule selects. Delivered back as `topic-event.path`.
    /// Use a leading `/` (the wasi-http provider normalizes to one).
    path: string,
  }

  /// Content-based routing for one subscription. Mirrors `TopicRoutes` /
  /// the HTTP API's `routes: {rules, default}`.
  record topic-routes {
    rules: list<topic-rule>,
    /// The path for events that no rule matches. `none` = the sidecar drops
    /// unmatched events (Dapr's behaviour without a default route).
    default: option<string>,
  }

  /// One topic this application subscribes to. Bulk subscribe is not
  /// modelled in this version.
  record topic-subscription {
    pubsub-name: string,
    topic: string,
    metadata: metadata,
    dead-letter-topic: option<string>,
    /// CEL routing rules. `none` = one route for the whole topic: events
    /// arrive without a `path`; dispatch in-app on (`pubsub-name`, `topic`).
    routes: option<topic-routes>,
  }

  /// A delivered event, compatible with CloudEvents spec v1.0. The provider
  /// parses the envelope; the app deserializes its domain payload from `data`.
  record topic-event {
    id: string,
    source: string,
    %type: string,
    spec-version: string,
    data-content-type: option<string>,
    data: list<u8>,
    topic: string,
    pubsub-name: string,
    /// The matched route: the `path` of the routing rule (or the routes'
    /// `default`) that selected this event. Set for subscriptions that
    /// declare `routes`.
    path: option<string>,
    /// CloudEvent extension attributes.
    extensions: metadata,
  }

  /// How the app handled the event. Maps to Dapr's
  /// SUCCESS / RETRY / DROP status.
  enum topic-event-response {
    success,
    retry,
    drop,
  }

  /// Declares the topics this app subscribes to. Called at startup.
  list-topic-subscriptions: func() -> list<topic-subscription>;

  /// Handle one delivered event. Dispatch on (`pubsub-name`, `topic`) and,
  /// for routed subscriptions, on `path`.
  on-topic-event: func(event: topic-event) -> topic-event-response;
}
