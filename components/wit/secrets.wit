/// Dapr secrets building block — **bulk** read: `get-bulk-secret`
/// enumerates every secret the app may read from a store, a wider authority
/// than reading one named secret (`secrets-read`).
/// https://docs.dapr.io/reference/api/secrets_api/
interface secrets {
  use types.{metadata};
  use secrets-read.{secret, secrets-error};

  /// Get all secrets the application is allowed to read from `store-name`,
  /// as (name, secret) pairs.
  get-bulk-secret: func(store-name: string, metadata: metadata) -> result<list<tuple<string, secret>>, secrets-error>;
}
