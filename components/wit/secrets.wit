/// Dapr secrets building block.
/// https://docs.dapr.io/reference/api/secrets_api/
interface secrets {
  use types.{metadata};

  /// A named secret may hold several key/value pairs
  /// (e.g. a Kubernetes secret with multiple entries).
  type secret = list<tuple<string, string>>;

  /// Setup/config failures common to every secrets operation.
  variant secrets-error {
    /// No secret store named `store-name` is configured.
    store-not-found(string),
    /// This app is not allowed to read from the store (API token /
    /// `allowedSecrets` / scoping).
    permission-denied(string),
  }

  /// Get the secret named `key` from the secret store `store-name`.
  /// Returns `none` when the secret does not exist (HTTP 204).
  get-secret: func(store-name: string, key: string, metadata: metadata) -> result<option<secret>, secrets-error>;

  /// Get all secrets the application is allowed to read from `store-name`,
  /// as (name, secret) pairs.
  get-bulk-secret: func(store-name: string, metadata: metadata) -> result<list<tuple<string, secret>>, secrets-error>;
}
