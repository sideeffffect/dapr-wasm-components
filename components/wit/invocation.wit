/// Dapr service invocation building block (HTTP semantics).
/// https://docs.dapr.io/reference/api/service_invocation_api/
interface invocation {
  use types.{metadata};

  /// Failure of `invoke`. A non-2xx reply from the target application is a
  /// normal `http-response`, not a failure; these are failures to *deliver*
  /// the call at all.
  variant invoke-error {
    /// The target application `app-id` could not be resolved or reached
    /// (unknown app id, name-resolution failure, the callee is down). Unlike
    /// an unreachable *sidecar* (which traps), a peer being down is a normal
    /// distributed-systems outcome the caller is expected to handle.
    app-unreachable(string),
    /// This app is not allowed to invoke `app-id` (API token / access
    /// control).
    permission-denied(string),
  }

  enum http-verb {
    get,
    post,
    put,
    delete,
    patch,
    head,
    options,
  }

  record http-response {
    status: u16,
    headers: metadata,
    body: list<u8>,
  }

  /// Invoke `method-path` (e.g. "orders/42") on the application `app-id`
  /// via its Dapr sidecar. Headers are passed through; `query` is the raw
  /// query string (without the leading `?`).
  /// Note: a non-2xx response from the target application is returned as a
  /// normal `http-response`, not as an `error`.
  invoke: func(
    app-id: string,
    method-path: string,
    verb: http-verb,
    headers: metadata,
    query: option<string>,
    body: list<u8>,
  ) -> result<http-response, invoke-error>;
}
