/// Dapr conversation building block (alpha) — talk to LLMs through Dapr.
/// Models the current `/v1.0-alpha2` converse API in full; the deprecated
/// alpha1 shape is not exposed.
/// https://docs.dapr.io/reference/api/conversation_api/
interface conversation {
  use types.{json, metadata};

  /// Setup/config failures common to every conversation operation.
  variant conversation-error {
    /// No conversation/LLM component named `component-name` is configured.
    component-not-found(string),
    /// This app is not allowed to use the component (API token / scoping).
    permission-denied(string),
  }

  /// Failure of `converse`.
  variant converse-error {
    /// `context-id` does not refer to a known chat to continue.
    context-not-found(string),
    /// The request was rejected by the model/component's content policy.
    content-filtered(string),
    /// The request was malformed (e.g. bad tool/response-format schema).
    invalid-request(string),
    conversation(conversation-error),
  }

  /// A single content part of a message. alpha2 carries message content as
  /// an ordered list of parts; only text parts exist today.
  record content-part {
    text: string,
  }

  /// The function a tool call invokes.
  record tool-call-function {
    name: string,
    /// Arguments as a JSON string, as generated by the model. The model may
    /// emit invalid JSON or hallucinated parameters — validate before use.
    arguments: string,
  }

  /// A tool call generated by the model (only function calls exist today).
  record tool-call {
    /// Provider-assigned id, used to correlate the matching tool result.
    id: option<string>,
    function: tool-call-function,
  }

  /// A developer/system/user message: an optional participant name and an
  /// ordered list of content parts.
  record participant-message {
    name: option<string>,
    content: list<content-part>,
  }

  /// An assistant message, which may also carry tool calls.
  record assistant-message {
    name: option<string>,
    content: list<content-part>,
    tool-calls: list<tool-call>,
  }

  /// A tool-result message, replying to a prior assistant tool call.
  record tool-message {
    /// Id of the tool call this message responds to.
    tool-id: option<string>,
    name: string,
    content: list<content-part>,
  }

  /// One message in a conversation input. The case selects the author role
  /// (maps to alpha2's `ofDeveloper`/`ofSystem`/`ofUser`/`ofAssistant`/`ofTool`).
  variant message {
    developer(participant-message),
    system(participant-message),
    user(participant-message),
    assistant(assistant-message),
    tool(tool-message),
  }

  /// One conversation turn: an ordered list of messages.
  record conversation-input {
    messages: list<message>,
    /// Scrub personally identifiable information from this input.
    scrub-pii: option<bool>,
  }

  /// A function the model may be allowed to call.
  record tool-function {
    name: string,
    description: option<string>,
    /// Parameters as a JSON Schema object; omit for an empty parameter list.
    parameters: option<json>,
  }

  /// A tool offered to the model (only function tools exist today).
  record tool {
    function: tool-function,
  }

  record conversation-options {
    /// Identifier of an existing chat, to continue it across converse calls.
    context-id: option<string>,
    /// Component-specific parameters as a JSON object.
    parameters: option<json>,
    metadata: metadata,
    /// Scrub PII from all inputs and outputs.
    scrub-pii: option<bool>,
    temperature: option<f64>,
    /// Tools offered to the model for this request.
    tools: list<tool>,
    /// Which tool the model may call: `none`, `auto`, `required`, or a
    /// specific tool name (casing/syntax must match the tool name).
    tool-choice: option<string>,
    /// Structured-output schema as a JSON Schema object.
    response-format: option<json>,
    /// Prompt-cache retention hint, e.g. "24h".
    prompt-cache-retention: option<string>,
  }

  /// Per-token usage breakdown for the prompt.
  record prompt-tokens-details {
    /// Audio input tokens present in the prompt.
    audio-tokens: u64,
    /// Cached tokens present in the prompt.
    cached-tokens: u64,
  }

  /// Per-token usage breakdown for the completion.
  record completion-tokens-details {
    /// Predicted-output tokens that appeared in the completion.
    accepted-prediction-tokens: u64,
    /// Audio tokens generated by the model.
    audio-tokens: u64,
    /// Tokens generated by the model for reasoning.
    reasoning-tokens: u64,
    /// Predicted-output tokens that did not appear in the completion.
    rejected-prediction-tokens: u64,
  }

  /// Token usage statistics for a completion.
  record usage {
    completion-tokens: u64,
    prompt-tokens: u64,
    total-tokens: u64,
    completion-tokens-details: option<completion-tokens-details>,
    prompt-tokens-details: option<prompt-tokens-details>,
  }

  /// A message generated by the model.
  record result-message {
    content: string,
    tool-calls: list<tool-call>,
  }

  /// One choice generated by the model for an input.
  record choice {
    /// e.g. "stop", "length", "tool_calls", "content_filter".
    finish-reason: string,
    /// Index of this choice in the output's choice list.
    index: s64,
    message: result-message,
  }

  /// The result for one conversation input.
  record conversation-output {
    choices: list<choice>,
    /// The model used for the conversation.
    model: option<string>,
    usage: option<usage>,
  }

  /// The converse response: one output per input, in order.
  record conversation-response {
    outputs: list<conversation-output>,
    /// Echoed conversation id, when the component returns one.
    context-id: option<string>,
  }

  /// Send inputs to the LLM component `component-name`.
  converse: func(
    component-name: string,
    inputs: list<conversation-input>,
    options: option<conversation-options>,
  ) -> result<conversation-response, converse-error>;
}
