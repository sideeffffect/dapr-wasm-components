/// Dapr cryptography building block (alpha).
/// The HTTP API is streaming-capable; this interface exposes the simple
/// one-shot form (whole payload in memory).
/// https://docs.dapr.io/reference/api/cryptography_api/
interface crypto {
  /// Setup/config failures common to every crypto operation.
  variant crypto-error {
    /// No crypto component named `component-name` is configured.
    component-not-found(string),
    /// This app is not allowed to use the component (API token / scoping).
    permission-denied(string),
  }

  /// Failure of `encrypt`.
  variant encrypt-error {
    /// The named key does not exist in the component's key vault.
    key-not-found(string),
    /// The key-wrap algorithm or data-encryption cipher is not supported.
    unsupported-algorithm(string),
    crypto(crypto-error),
  }

  /// Failure of `decrypt`.
  variant decrypt-error {
    /// The key needed to decrypt does not exist.
    key-not-found(string),
    /// The ciphertext is not a well-formed encrypted document, or its
    /// authentication tag did not verify.
    malformed-ciphertext(string),
    crypto(crypto-error),
  }

  record encrypt-options {
    /// Name (or name/version) of the key to use for the encryption.
    key-name: string,
    /// Key wrapping algorithm, e.g. A256KW, RSA.
    key-wrap-algorithm: string,
    /// Cipher used to encrypt data: aes-gcm (default) or chacha20-poly1305.
    data-encryption-cipher: option<string>,
    /// Do not embed the key name in the encrypted document.
    omit-decryption-key-name: option<bool>,
    /// Key name to embed for decryption, when different from `key-name`.
    decryption-key-name: option<string>,
  }

  /// Encrypt `data` using the crypto component `component-name`.
  encrypt: func(component-name: string, data: list<u8>, options: encrypt-options) -> result<list<u8>, encrypt-error>;

  /// Decrypt `data`. `key-name` is only needed when it was omitted from
  /// the encrypted document.
  decrypt: func(component-name: string, data: list<u8>, key-name: option<string>) -> result<list<u8>, decrypt-error>;
}
