/// Dapr actors building block — client-side operations.
/// Hosting actors requires an app-channel runtime and is out of scope for
/// this outbound interface.
/// https://docs.dapr.io/reference/api/actors_api/
interface actors {
  use types.{json};

  /// Setup/config failures common to every actors operation.
  variant actors-error {
    /// This app is not allowed to perform the actor operation (API token /
    /// access control).
    permission-denied(string),
  }

  /// Failure of `invoke`.
  variant invoke-actor-error {
    /// The invoked actor method returned an error. Carries the actor's own
    /// error payload (application-defined).
    actor-error(list<u8>),
    actors(actors-error),
  }

  /// Failure of `get-state`.
  variant get-state-error {
    /// No actor state is stored under `key`.
    key-not-found,
    actors(actors-error),
  }

  /// Failure of `get-reminder`.
  variant get-reminder-error {
    /// No reminder with that name exists on the actor.
    reminder-not-found,
    actors(actors-error),
  }

  enum actor-state-operation-type {
    upsert,
    delete,
  }

  record actor-state-operation {
    operation: actor-state-operation-type,
    key: string,
    /// Required for upsert; ignored for delete.
    value: option<list<u8>>,
  }

  record reminder {
    /// ISO timestamp or Go duration until the first invocation.
    due-time: option<string>,
    /// Invocation period, e.g. "1m" or "R5/PT1M" (5 repetitions).
    period: option<string>,
    ttl: option<string>,
    /// JSON payload passed to the reminder callback.
    data: option<json>,
  }

  record timer {
    due-time: option<string>,
    period: option<string>,
    ttl: option<string>,
    data: option<json>,
    /// Method on the actor to invoke when the timer fires.
    callback: option<string>,
  }

  /// Invoke `method` on the actor `actor-type`/`actor-id`.
  invoke: func(
    actor-type: string,
    actor-id: string,
    method: string,
    body: list<u8>,
    content-type: option<string>,
  ) -> result<list<u8>, invoke-actor-error>;

  /// Get the actor state stored under `key`. Fails with `key-not-found`
  /// when absent.
  get-state: func(actor-type: string, actor-id: string, key: string) -> result<list<u8>, get-state-error>;

  /// Execute upserts and deletes of actor state atomically.
  execute-state-transaction: func(
    actor-type: string,
    actor-id: string,
    operations: list<actor-state-operation>,
  ) -> result<_, actors-error>;

  /// Create (or overwrite) a persistent reminder.
  register-reminder: func(actor-type: string, actor-id: string, name: string, reminder: reminder) -> result<_, actors-error>;

  /// Get a reminder's definition as JSON. Fails with `reminder-not-found`
  /// when no such reminder exists.
  get-reminder: func(actor-type: string, actor-id: string, name: string) -> result<json, get-reminder-error>;

  /// Delete a reminder.
  unregister-reminder: func(actor-type: string, actor-id: string, name: string) -> result<_, actors-error>;

  /// Create (or overwrite) a non-persistent timer.
  register-timer: func(actor-type: string, actor-id: string, name: string, timer: timer) -> result<_, actors-error>;

  /// Delete a timer.
  unregister-timer: func(actor-type: string, actor-id: string, name: string) -> result<_, actors-error>;
}
