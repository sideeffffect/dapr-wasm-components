/// Dapr distributed lock building block (alpha).
/// https://docs.dapr.io/reference/api/distributed_lock_api/
interface lock {
  /// Setup/config failures common to every lock operation.
  variant lock-error {
    /// No lock store named `store-name` is configured.
    store-not-found(string),
    /// This app is not allowed to use the lock store (API token / scoping).
    permission-denied(string),
  }

  /// Failure of `try-lock`. Acquiring the lock is the only happy path; the
  /// lock already being held is an expected error.
  variant try-lock-error {
    /// The lock is currently held by someone else — not acquired.
    not-acquired,
    lock(lock-error),
  }

  /// Failure of `unlock`. Releasing the lock is the only happy path.
  variant unlock-error {
    /// There is no lock on `resource-id` to release.
    lock-does-not-exist,
    /// The lock is held by a different owner, so it was not released.
    lock-belongs-to-others,
    lock(lock-error),
  }

  /// Acquire a lock on `resource-id`. Succeeds when the lock is obtained;
  /// fails with `not-acquired` when it is already held. The lock auto-expires
  /// after `expiry-in-seconds`.
  try-lock: func(
    store-name: string,
    resource-id: string,
    lock-owner: string,
    expiry-in-seconds: u32,
  ) -> result<_, try-lock-error>;

  /// Release a lock previously acquired by `lock-owner`.
  unlock: func(store-name: string, resource-id: string, lock-owner: string) -> result<_, unlock-error>;
}
