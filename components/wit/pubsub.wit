/// Dapr publish & subscribe building block — publishing (outbound) side.
/// Subscribing and event delivery are the inbound direction: see the
/// `pubsub-callback` interface.
/// https://docs.dapr.io/reference/api/pubsub_api/
interface pubsub {
  use types.{metadata, error};

  /// One event of a bulk publish.
  record bulk-publish-entry {
    /// Unique identifier of the entry within the request.
    entry-id: string,
    event: list<u8>,
    content-type: string,
    metadata: metadata,
  }

  /// An entry the sidecar failed to publish.
  record bulk-publish-failed-entry {
    entry-id: string,
    error: string,
  }

  /// Publish `data` to `topic` on the pub/sub component `pubsub-name`.
  /// `data-content-type` is the MIME type of `data`, e.g. `application/json`;
  /// when absent the sidecar defaults it (`text/plain`).
  publish: func(
    pubsub-name: string,
    topic: string,
    data: list<u8>,
    data-content-type: option<string>,
    metadata: metadata,
  ) -> result<_, error>;

  /// Publish several events in one request (alpha). Returns the entries
  /// that failed — an empty list means everything was published.
  publish-bulk: func(
    pubsub-name: string,
    topic: string,
    entries: list<bulk-publish-entry>,
    metadata: metadata,
  ) -> result<list<bulk-publish-failed-entry>, error>;
}
