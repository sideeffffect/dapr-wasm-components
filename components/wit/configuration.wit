/// Dapr configuration building block — **subscribe**. `subscribe` starts a
/// watch; the sidecar then pushes updates to the application, which the
/// provider delivers as typed calls to the `configuration-callback`
/// interface (inbound direction). The read side lives in
/// `configuration-read`.
/// https://docs.dapr.io/reference/api/configuration_api/
interface configuration {
  use types.{metadata};
  use configuration-read.{configuration-error};

  /// An active configuration subscription. Updates for it reach the
  /// application through `configuration-callback`, tagged with `id`.
  /// **Dropping the handle unsubscribes.** The drop cannot report a failure:
  /// a provider that fails to unsubscribe logs it and carries on (the
  /// sidecar then keeps pushing updates for `id` until it stops).
  resource subscription {
    /// The subscription id the sidecar assigned; matches
    /// `configuration-update.id` in the callback.
    id: func() -> string;
  }

  /// Subscribe to changes of the items named `keys` (all items when empty)
  /// in `store-name`. Updates are delivered to the application through the
  /// `configuration-callback` interface; drop the returned handle to stop
  /// them.
  /// https://docs.dapr.io/reference/api/configuration_api/#watch-configuration
  subscribe: func(store-name: string, keys: list<string>, metadata: metadata) -> result<subscription, configuration-error>;
}
