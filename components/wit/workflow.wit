/// Dapr workflow building block (management operations).
/// Authoring workflows requires an app-channel worker and is out of scope
/// for this outbound interface. Note: Dapr has deprecated the workflow
/// HTTP API in favor of SDKs; it is still served as of v1.18.
///
/// Dapr has a single workflow engine, the built-in workflow component
/// `dapr`, so the functions take no component name: providers always target
/// `dapr`.
/// https://docs.dapr.io/reference/api/workflow_api/
interface workflow {
  /// Setup/config failures common to every workflow operation.
  variant workflow-error {
    /// The sidecar's workflow engine (the built-in `dapr` workflow
    /// component) is not available — e.g. the actor runtime / placement it
    /// runs on is not configured.
    component-not-found(string),
    /// This app is not allowed to use the component (API token / scoping).
    permission-denied(string),
  }

  /// Failure of `start`.
  variant start-error {
    /// An instance with that `instance-id` already exists.
    instance-already-exists(string),
    workflow(workflow-error),
  }

  /// Failure of the operations that act on an existing instance
  /// (`terminate`/`raise-event`/`pause`/`resume`/`purge`).
  variant instance-error {
    /// No workflow instance with that `instance-id`.
    not-found(string),
    /// The instance is not in a state that permits this operation
    /// (e.g. resuming a workflow that is not paused, purging a running one).
    invalid-state(string),
    workflow(workflow-error),
  }

  /// Failure of `get`.
  variant get-error {
    /// No workflow instance with that `instance-id`.
    not-found(string),
    workflow(workflow-error),
  }

  record workflow-instance {
    instance-id: string,
    created-at: string,
    last-updated-at: string,
    /// e.g. RUNNING, COMPLETED, CONTINUED_AS_NEW, FAILED, CANCELED,
    /// TERMINATED, PENDING, SUSPENDED
    runtime-status: string,
    /// Additional runtime properties (e.g. dapr.workflow.input/output).
    properties: list<tuple<string, string>>,
  }

  /// Start a new workflow instance. Returns the instance id.
  start: func(
    workflow-name: string,
    instance-id: option<string>,
    input: list<u8>,
  ) -> result<string, start-error>;

  /// Get information about a workflow instance. Fails with `not-found` when
  /// no instance with that id exists.
  get: func(instance-id: string) -> result<workflow-instance, get-error>;

  /// Terminate a running workflow instance.
  terminate: func(instance-id: string) -> result<_, instance-error>;

  /// Deliver an external event to a workflow instance.
  raise-event: func(
    instance-id: string,
    event-name: string,
    event-data: list<u8>,
  ) -> result<_, instance-error>;

  /// Pause a running workflow instance.
  pause: func(instance-id: string) -> result<_, instance-error>;

  /// Resume a paused workflow instance.
  resume: func(instance-id: string) -> result<_, instance-error>;

  /// Purge the state of a terminated/completed workflow instance.
  purge: func(instance-id: string) -> result<_, instance-error>;
}
